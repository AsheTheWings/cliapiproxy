# Generated from internal/inputs/schema.json by scripts/generate-env.sh; do not edit.
# Development defaults of the environment inputs, for reading: no process or tool loads
# this file. Flags and the keys of the overlay and protected files are in the schema.

# Profile whose defaults apply.
# Required in development.
CLIPROXY_PROFILE=

# Home directory the XDG base directory defaults derive from.
# Required in development.
HOME=

# XDG state base directory.
XDG_STATE_HOME=${HOME}/.local/state

# XDG runtime directory, which holds the development protected file.
# Required in development.
XDG_RUNTIME_DIR=

# Colon-separated YAML files of configuration inputs; a later file overrides an earlier one.
CLIPROXY_OVERLAY_FILES=

# YAML file of protected inputs, readable by its owner alone.
CLIPROXY_PROTECTED_FILE=${XDG_RUNTIME_DIR}/cliapiproxy/protected.yaml

# Trace exporter: otlp, console, or none.
OTEL_TRACES_EXPORTER=otlp

# Metric exporter: otlp, console, or none.
OTEL_METRICS_EXPORTER=otlp

# Log exporter: otlp, console, or none.
OTEL_LOGS_EXPORTER=otlp

# OTLP/HTTP base URL; each signal appends its path.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Deployment environment the telemetry reports.
CLIPROXY_DEPLOYMENT_ENVIRONMENT=development
