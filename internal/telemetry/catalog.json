{
  "schema_version": "opentelemetry.producer/signal-catalog/v1",
  "catalog_version": 4,
  "service_namespace": "cliapiproxy",
  "service_names": ["cliapiproxy"],
  "catalog": {
    "traces": [
      "cliapiproxy.qualification",
      "cliapiproxy.execute",
      "cliapiproxy.codex.client_models",
      "cliapiproxy.usage.poll"
    ],
    "trace_name_patterns": [
      "^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS|CONNECT|TRACE|HTTP)( /[^ ]*)?$"
    ],
    "metrics": [
      "cliapiproxy.qualification",
      "http.server.request.duration",
      "cliapiproxy.execute.duration",
      "cliapiproxy.generation.tokens",
      "cliapiproxy.store.dropped",
      "cliapiproxy.store.write.duration",
      "cliapiproxy.store.queue.entries",
      "cliapiproxy.store.queue.bytes",
      "cliapiproxy.store.database.size",
      "cliapiproxy.usage.poll.duration",
      "cliapiproxy.usage.remaining"
    ],
    "logs": [
      "cliapiproxy.qualification",
      "cliapiproxy.log"
    ],
    "correlation_attributes": ["cliapiproxy.correlation.id"]
  },
  "allowed_attributes": {
    "traces": [
      "cliapiproxy.correlation.id",
      "http.request.method",
      "http.route",
      "http.response.status_code",
      "error.type",
      "cliapiproxy.operation",
      "cliapiproxy.provider",
      "cliapiproxy.codex.optimize_multi_agent_v2",
      "cliapiproxy.codex.template_models",
      "cliapiproxy.codex.synthesized_models",
      "cliapiproxy.codex.synthesized_multi_agent_v2",
      "cliapiproxy.codex.fallback_template",
      "cliapiproxy.usage.poll_outcome"
    ],
    "metrics": [
      "http.request.method",
      "http.route",
      "http.response.status_code",
      "error.type",
      "cliapiproxy.operation",
      "cliapiproxy.provider",
      "cliapiproxy.token.type",
      "cliapiproxy.store.drop_reason",
      "cliapiproxy.store.write_outcome",
      "cliapiproxy.usage.poll_outcome",
      "cliapiproxy.usage.meter"
    ],
    "logs": [
      "cliapiproxy.correlation.id",
      "code.file.path",
      "code.line.number",
      "code.function.name",
      "error.type"
    ]
  },
  "metric_dimensions": {
    "http.request.method": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "CONNECT", "TRACE", "_OTHER"],
    "cliapiproxy.operation": ["execute", "count", "stream"],
    "cliapiproxy.token.type": ["input_uncached", "input_cache_read", "input_cache_write", "output_non_reasoning", "output_reasoning", "unclassified"],
    "cliapiproxy.store.drop_reason": ["queue_entries", "queue_bytes", "terminal_write", "shutdown"],
    "cliapiproxy.store.write_outcome": ["ok", "retryable", "terminal"],
    "cliapiproxy.usage.poll_outcome": ["ok", "timeout", "http_error", "unparseable", "unchanged"],
    "cliapiproxy.usage.meter": ["five_hour", "daily", "weekly", "monthly", "balance", "other"]
  },
  "metric_units": {
    "cliapiproxy.qualification": "{probe}",
    "http.server.request.duration": "s",
    "cliapiproxy.execute.duration": "s",
    "cliapiproxy.generation.tokens": "{token}",
    "cliapiproxy.store.dropped": "{generation}",
    "cliapiproxy.store.write.duration": "s",
    "cliapiproxy.store.queue.entries": "{generation}",
    "cliapiproxy.store.queue.bytes": "By",
    "cliapiproxy.store.database.size": "By",
    "cliapiproxy.usage.poll.duration": "s",
    "cliapiproxy.usage.remaining": "1"
  },
  "error_classes": [
    "canceled",
    "timeout",
    "unauthorized",
    "rate_limited",
    "client_error",
    "upstream_error",
    "no_credential",
    "network",
    "other"
  ],
  "error_type_patterns": ["^5[0-9][0-9]$"],
  "qualification": {
    "trace_name": "cliapiproxy.qualification",
    "metric_name": "cliapiproxy.qualification",
    "log_name": "cliapiproxy.qualification",
    "correlation_attribute": "cliapiproxy.correlation.id"
  }
}
